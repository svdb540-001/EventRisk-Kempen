# ============================================================
# EVENTRISK KEMPEN — LOKALE ONTWIKKELING
# Kopieer naar .env. Deze waarden zijn NIET voor productie.
# ============================================================
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
TRUST_PROXY=false
MAX_UPLOAD_MB=20

# Lokale opslag
DATABASE_PROVIDER=sqlite
DATABASE_PATH=./data/eventrisk.db
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=eventrisk
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
STORAGE_PROVIDER=local
UPLOAD_DIR=./data/uploads
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=eventrisk-documents

# Lokale testlogin
AUTH_MODE=development
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_SPA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/EventRisk.Access
ENTRA_ALLOWED_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_ALLOWED_ROLES=EventRisk.Admin,EventRisk.Coordinator,EventRisk.D1,EventRisk.D2,EventRisk.D3
ENTRA_ALLOWED_GROUP_IDS=
DEV_USER_NAME=Sanne Testgebruiker
DEV_USER_EMAIL=sanne.test@brandweerzonekempen.be
DEV_USER_ROLE=EventRisk.Admin

# Synchronisatie
SYNC_AUTOMATIC=false
SYNC_INTERVAL_MINUTES=15
MOCK_CONNECTORS=true

# Eaglebe — pas activeren na officiële sandboxgegevens
EAGLEBE_ENABLED=false
EAGLEBE_BASE_URL=
EAGLEBE_TOKEN_URL=
EAGLEBE_CLIENT_ID=
EAGLEBE_CLIENT_SECRET=
EAGLEBE_SCOPE=
EAGLEBE_EVENTS_PATH=/api/events
EAGLEBE_EVENT_PATH_TEMPLATE=/api/events/{externalId}
EAGLEBE_FEEDBACK_PATH_TEMPLATE=/api/events/{externalId}/advice
EAGLEBE_CHANGED_SINCE_PARAM=changedSince
EAGLEBE_FEEDBACK_METHOD=POST

# Flowlab — pas activeren na officiële sandboxgegevens
FLOWLAB_ENABLED=false
FLOWLAB_BASE_URL=
FLOWLAB_API_KEY=
FLOWLAB_AUTH_HEADER=X-Api-Key
FLOWLAB_EVENTS_PATH=/api/events
FLOWLAB_EVENT_PATH_TEMPLATE=/api/events/{externalId}
FLOWLAB_FEEDBACK_PATH_TEMPLATE=/api/events/{externalId}/advice
FLOWLAB_CHANGED_SINCE_PARAM=changedSince
FLOWLAB_FEEDBACK_METHOD=POST
FLOWLAB_WEBHOOK_SECRET=

# ============================================================
# PRODUCTIEVEREISTEN (Azure App Service)
# NODE_ENV=production
# AUTH_MODE=entra
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgresql://...  OF gebruik DATABASE_HOST/NAME/USER/PASSWORD
# DATABASE_SSL=true
# STORAGE_PROVIDER=azure
# AZURE_STORAGE_ACCOUNT_NAME=<accountnaam>  (managed identity)
# MOCK_CONNECTORS=false
# APP_BASE_URL=https://<appnaam>.azurewebsites.net
# ============================================================
