# Application
APP_NAME=EventRisk Kempen
APP_ENV=development
APP_PORT=3000

# Auth (Microsoft Entra ID)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3000/auth/callback

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/eventrisk

# Redis / Queue
REDIS_URL=redis://localhost:6379

# Storage
STORAGE_PROVIDER=azure
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=eventrisk-docs

# Integrations - Eaglebe
EAGLEBE_BASE_URL=
EAGLEBE_CLIENT_ID=
EAGLEBE_CLIENT_SECRET=
EAGLEBE_WEBHOOK_SECRET=

# Integrations - Flowlab
FLOWLAB_BASE_URL=
FLOWLAB_API_KEY=
FLOWLAB_WEBHOOK_SECRET=

# Sync behavior
SYNC_POLL_INTERVAL_MINUTES=10
SYNC_RETRY_MAX_ATTEMPTS=8
SYNC_RETRY_BACKOFF_SECONDS=30
